# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead. Never commit .env.

# Required: powers the AI audits.
ANTHROPIC_API_KEY=

# Optional: "Continue with Google" sign-in and Gmail receipt import
# (Google Cloud Console → Credentials → OAuth client, type "Web"). Authorized redirect URIs:
#   https://ecoaudit.miles-ehrlich.com/auth/google/login     (sign-in: name + email only)
#   https://ecoaudit.miles-ehrlich.com/auth/google/callback  (Gmail import: gmail.readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set automatically when you add Upstash Redis from the Vercel dashboard (Storage tab).
# Leave empty locally to use in-memory storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: signs session cookies. If unset, one is derived from ANTHROPIC_API_KEY.
SESSION_SECRET=

# Optional usage limits (defaults shown).
# AI_LIMIT_USER_DAY=40
# AI_LIMIT_IP_DAY=80
# AI_LIMIT_IP_MINUTE=8
# AI_LIMIT_GLOBAL_DAY=300
# SIGNUP_LIMIT_IP_DAY=5
# LOGIN_LIMIT_IP_15MIN=20
