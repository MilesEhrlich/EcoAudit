{
  "manifest_version": 3,
  "name": "EcoAudit — Sustainability Auditor",
  "version": "1.1.0",
  "description": "Real-time AI sustainability auditor for online shopping. Deconstructs greenwashing claims and surfaces local alternatives.",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EcoAudit",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["set-extension-id.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.hm.com/*",
        "*://*.zara.com/*",
        "*://*.nike.com/*",
        "*://*.adidas.com/*",
        "*://*.patagonia.com/*",
        "*://*.nordstrom.com/*",
        "*://*.gap.com/*",
        "*://*.target.com/*",
        "*://*.walmart.com/*",
        "*://*.etsy.com/*",
        "*://*.ebay.com/*",
        "*://*.asos.com/*",
        "*://*.uniqlo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.hm.com/*",
    "*://*.zara.com/*",
    "*://*.nike.com/*",
    "*://*.adidas.com/*",
    "*://*.patagonia.com/*",
    "*://*.nordstrom.com/*",
    "*://*.gap.com/*",
    "*://*.target.com/*",
    "*://*.walmart.com/*",
    "*://*.etsy.com/*",
    "*://*.ebay.com/*",
    "*://*.asos.com/*",
    "*://*.uniqlo.com/*",
    "http://localhost:3000/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
